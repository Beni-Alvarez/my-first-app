# Copy this file to server/.env and adjust if needed.
DATABASE_URL="postgresql://songs:songs@localhost:5432/songs?schema=public"
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Used only by `npm run test:db`. Its tables are wiped on every run, so it must be a separate database.
TEST_DATABASE_URL="postgresql://songs:songs@localhost:5432/songs_test?schema=public"
